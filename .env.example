# ── The Grace — environment configuration ─────────────────────────────
# Copy to .env.local and fill in real values. Everything has a safe
# fallback: the site runs fully in demo mode with no env vars at all.

# Public site URL (used for sitemap, OG tags, WhatsApp links back to pages)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Contact / ordering (critical path) ────────────────────────────────
# WhatsApp number in international format WITHOUT "+" (used in wa.me links)
NEXT_PUBLIC_WHATSAPP_NUMBER=917009112154
NEXT_PUBLIC_PHONE=+917009112154
NEXT_PUBLIC_PHONE_SECONDARY=+919899976380
NEXT_PUBLIC_EMAIL=info@thegrace.co.in

# ── Razorpay (primary payment gateway, India) ─────────────────────────
# Leave empty to hide online payment and offer COD + WhatsApp ordering only.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cash on Delivery toggle ("true" / "false")
NEXT_PUBLIC_COD_ENABLED=true

# ── Admin dashboard ────────────────────────────────────────────────────
# Password for /admin (default if unset: grace-admin-2026 — change it!)
ADMIN_PASSWORD=grace-admin-2026

# ── Order notification emails (optional — silently skipped if unset) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ORDER_NOTIFY_EMAIL=info@thegrace.co.in
