# generated media is COMMITTED so Vercel serves it (the ingest source
# `Images/` below is not deployed). Re-run `npm run ingest` to regenerate.

# source photo library (261 MB, kept locally only — not needed to deploy).
# Leading slash anchors to repo root so it does NOT also match
# public/images/ (git is case-insensitive on Windows: Images == images).
/Images/

# runtime database & uploads (leading slash = repo root only, so this does
# NOT match src/data/ — the committed catalog the app imports)
/data/
/public/uploads/

